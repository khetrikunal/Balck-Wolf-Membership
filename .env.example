# Frontend (public values only — safe to expose in the browser)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx

# Edge Function secrets are NOT stored here. Set them with:
#   supabase secrets set RAZORPAY_KEY_ID=... RAZORPAY_KEY_SECRET=... RAZORPAY_WEBHOOK_SECRET=... SITE_URL=https://your-domain
# (SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected by Supabase automatically.)
